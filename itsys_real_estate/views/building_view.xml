        <record model="ir.actions.act_window" id="building_act1">
            <field name="name">Block</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">building</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="building_list"/>
            <!-- <field name="search_view_id" ref="building_filter"/> -->
        </record> 

   
        
        <menuitem id="menu_itsys_real_estate" name="Real Estate" web_icon="itsys_real_estate,static/description/icon.png" sequence="28"/>
        <menuitem id="menu_settings" name="Settings" parent="menu_itsys_real_estate" sequence="2000"/>


        <menuitem id="menu_building_list" name="Property structure" parent="menu_itsys_real_estate" sequence="1"/>

        
        <menuitem sequence="3" action="building_act1" name="Blocks"  id="menu_building_list_sub" parent="menu_building_list"/>




    </data>
</odoo>
